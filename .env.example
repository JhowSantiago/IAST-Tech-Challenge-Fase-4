# Credenciais OpenAI (obrigatório para geração real e embeddings online)
OPENAI_API_KEY="sua-chave-openai-aqui"

# Modelos OpenAI utilizados no pipeline RAG
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Parâmetros de recuperação semântica e governança de evidências
RAG_TOP_K=5
RAG_MULTI_QUERY_COUNT=3
RAG_RELEVANCE_THRESHOLD=0.45
